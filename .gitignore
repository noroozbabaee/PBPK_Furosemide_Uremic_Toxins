# .gitignore
# ==========
# Generated run outputs — results/ should be empty in the repository and
# populate locally when scripts are run. Caches (.npz/.pkl), CSVs, and
# figures (PNG/PDF) generated by analysis/ and figures/ scripts all land
# here and should never be committed.
results/*
!results/.gitkeep

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
*_env/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Jupyter notebook checkpoints (relevant once notebooks/ is populated)
.ipynb_checkpoints/

# Packaging artifacts
*.egg-info/
build/
dist/
